{
  "name": "d365fo-agentic",
  "version": "0.1.0",
  "description": "Desktop D365 Finance & Operations test assistant with app-owned Chat and Claude.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "d365fo-agent": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "npm run clean && tsc -p tsconfig.json --watch",
    "start": "node dist/cli/index.js",
    "agent": "node dist/cli/index.js",
    "ui": "npm run build && node dist/cli/index.js ui",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "npm run build && node scripts/run-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.64.0-alpha-1789764292000",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "playwright": "1.64.0-alpha-1789764292000",
    "undici": "^6.29.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.5.3"
  }
}
