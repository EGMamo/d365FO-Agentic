# ─────────────────────────────────────────────────────────────
# d365FO-Agentic — example environment configuration
# Copy to `.env` and fill in the values you need. LLM_PROVIDER
# picks the provider (default anthropic); it is not detected
# from which keys are present. A saved settings profile (`ui`,
# `--profile`) replaces this file when one is in use.
# ─────────────────────────────────────────────────────────────

# ── LLM provider ────────────────────────────────────────────
# One of: anthropic | openai | azure-openai | github-models | github-copilot | openai-compatible
LLM_PROVIDER=anthropic
# Model for the anthropic provider (other providers use their own *_MODEL below)
LLM_MODEL=claude-opus-4-5-20251101
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
# Anthropic only: cache the system prompt, tool schemas and conversation between turns (cheaper, faster). Set false to disable.
LLM_PROMPT_CACHE=true

# Anthropic (Claude) — default
ANTHROPIC_API_KEY=
# Optional: a Claude-compatible endpoint other than api.anthropic.com (company gateway, proxy, model router).
# Give the base address; a trailing /v1 or /v1/messages is accepted and removed.
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com/anthropic
# Optional: bearer token for a gateway that takes one in place of an API key (sent as Authorization: Bearer).
# ANTHROPIC_AUTH_TOKEN=

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# GitHub Copilot (optional) — uses your Copilot subscription.
# Sign in once with `node dist/cli/index.js copilot-login`, or set a token here (e.g. CI).
GITHUB_COPILOT_TOKEN=
GITHUB_COPILOT_MODEL=gpt-4.1

# Local or any OpenAI-compatible model (optional): Ollama, LM Studio, llama.cpp, vLLM. Set LLM_PROVIDER=openai-compatible.
# The model must support tool calling and have a context window of at least 32k tokens (Ollama: OLLAMA_CONTEXT_LENGTH).
# Thinking models need LLM_MAX_TOKENS=8192 or more. See docs/providers.md.
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# Only for hosted endpoints; local servers need no key.
OPENAI_COMPATIBLE_API_KEY=

# GitHub Models (optional) — separate prototyping API, not billed via Copilot
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o

# ── Azure DevOps ────────────────────────────────────────────
# PAT scopes required: Work Items (Read), Test Management (Read & Write)
AZDO_ORG_URL=https://dev.azure.com/your-org
AZDO_PROJECT=YourProject
AZDO_PAT=
AZDO_TEST_PLAN_ID=
AZDO_TEST_SUITE_ID=
# Has no effect on runs: test cases are read and results published through the Azure DevOps REST API.
# (When true, the Azure DevOps MCP server is registered, but the agent never connects to it.)
AZDO_USE_MCP=false

# ── D365 Finance & Operations ───────────────────────────────
D365_BASE_URL=https://your-sandbox.sandbox.operations.dynamics.com
# Optional Entra app registration (client credentials). Gives the agent read-only OData checks
# (d365_odata_query) and is enough on its own for data-only test cases; browser steps still need a
# user sign-in below. Register the client id in F&O: System administration > Setup > Microsoft Entra ID applications.
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
# Sovereign clouds only, e.g. https://login.microsoftonline.us
D365_AUTHORITY_HOST=
D365_USERNAME=
# A password containing # must be quoted, e.g. D365_PASSWORD='Ab12#@!z'. Unquoted, the .env parser treats everything
# from the # on as a comment and silently uses only the part before it. `doctor` and `run` catch this.
D365_PASSWORD=
# Optional, safer than a password: reuse a saved browser session. Create it once with
#   node dist/cli/index.js session-login
# (you sign in yourself, MFA included), then point at the file. Runs use it instead of the
# password; username/password stay as a fallback. Leave empty to keep password login.
D365_STORAGE_STATE=
# `doctor` warns when the saved session is older than this many hours.
D365_SESSION_MAX_AGE_HOURS=12
# Legal entity / company code used for test runs
D365_COMPANY=USMF
# What D365_BASE_URL is: sandbox | production | dev. Leave empty to guess from the URL.
# Only LCS-managed sandboxes (<name>.sandbox.operations...) are recognised from the host. Power Platform (unified)
# environments use <name>.operations.<geo>.dynamics.com for sandbox and production alike, so they look like
# production: declare `sandbox` here or `run` refuses to start.
D365_ENVIRONMENT_TYPE=

# ── Playwright MCP ──────────────────────────────────────────
PW_HEADLESS=true
# Save a Playwright trace per attempt: on | off | on-failure (kept only for attempts that did not pass)
PW_TRACE=on-failure
# Accepted (on | off | on-failure) but not used: no video is recorded.
PW_VIDEO=off
PW_BROWSER=chromium
# macOS/Linux: the server runs in its own process group so the first Ctrl+C does not kill the browser.
# Set to false to start it directly.
# MCP_SHIELD=true
# Download the Playwright browser (~300 MB, once) automatically before a run when it is missing.
# Set false in offline/locked-down environments and install it yourself:
#   npx @playwright/mcp install-browser chrome-for-testing   (firefox / webkit for those PW_BROWSER values)
PW_AUTO_INSTALL=true
# How long an action waits for its element (F&O renders slowly; Playwright's own default is 5000)
PW_ACTION_TIMEOUT_MS=15000

# ── F&O speed and learning ──────────────────────────────────
# Wait for F&O's "Please wait" overlay after each click/type, and retry a learned target once when the form was still loading
AGENT_FNO_AUTO_WAIT=true
# Drop anonymous wrapper nodes from page snapshots (smaller prompts, nothing actionable is lost)
AGENT_SLIM_SNAPSHOTS=true
# Learn the locator of every control used, per form, in <KB_DIR>/pages.json and reuse it on later visits
AGENT_LEARN_PAGES=true
# Replay a case from the recorded Playwright code of its last passing run before asking the AI (<KB_DIR>/replays.json).
# Only cases whose expected results were all checked with a recorded assertion; a failed replay falls back to the AI.
AGENT_REPLAY=true

# ── Microsoft Learn MCP ─────────────────────────────────────
LEARN_MCP_URL=https://learn.microsoft.com/api/mcp
# Optional: a running Release Planner MCP server (FastTrack sample), e.g. http://localhost:3000/mcp. Read-only tools; leave empty to disable.
RELEASE_PLANNER_MCP_URL=

# ── Agent behavior ──────────────────────────────────────────
# dry-run: skip browser actions that change state (click/type/fill/...); navigation and snapshots still run
AGENT_DRY_RUN=false
# Print every model turn and tool call (Playwright actions included) with a truncated result
AGENT_VERBOSE=true
# Max iterations of the plan→act loop per test case
AGENT_MAX_STEPS=40
# Time budget per tool call, and for navigation calls; a call over budget is reported and recorded as a timeout
AGENT_TOOL_TIMEOUT_MS=60000
AGENT_NAV_TIMEOUT_MS=90000
# Stop a test case after this many identical consecutive tool calls (0 disables)
AGENT_MAX_REPEATED_CALLS=3
# Keep this many of the latest bulky tool results (page snapshots) verbatim and collapse older ones, so the
# prompt stops growing every step. Collapsing happens in batches (when 2x this many pile up). 0 disables.
AGENT_CONTEXT_KEEP_RECENT=3
# Guardrails, enforced in code. Runs against a production-looking environment are refused unless this is true.
AGENT_ALLOW_PRODUCTION=false
# The agent may navigate only to the F&O host and Microsoft sign-in pages. Add more hosts here (comma-separated;
# `*.example.com` also matches subdomains), e.g. an ADFS server or lcs.dynamics.com.
AGENT_ALLOWED_HOSTS=
# Only a safe subset of the Playwright and Learn MCP tools is exposed (no cookie/storage dumps, arbitrary JS,
# file access). Opt more in by the name the model sees, comma-separated; a trailing * matches a prefix,
# e.g. playwright__browser_file_upload,playwright__browser_cookie_*
AGENT_ALLOWED_TOOLS_EXTRA=
# Reloop controls (retries apply to failed/blocked outcomes by default)
AGENT_RELOOP_MAX_RETRIES=1
AGENT_RELOOP_RETRY_ON=failed,blocked
AGENT_RELOOP_COOLDOWN_MS=1000
# LLM network resilience
LLM_HTTP_TIMEOUT_MS=60000
LLM_HTTP_MAX_RETRIES=2
LLM_HTTP_RETRY_BASE_MS=500
# Azure DevOps network resilience
AZDO_HTTP_TIMEOUT_MS=60000
AZDO_HTTP_MAX_RETRIES=3
AZDO_HTTP_RETRY_BASE_MS=800
# Directory for local knowledge base
KB_DIR=./knowledge
# Directory for reports and artifacts
REPORT_DIR=./reports

# Run limits per test attempt (0 turns a limit off)
AGENT_TEST_TIMEOUT_MS=900000
AGENT_MAX_TOKENS_PER_TEST=1000000
AGENT_MAX_CONSECUTIVE_ERRORS=5
AGENT_MAX_UNREACHABLE_TARGETS=3
# Stop at once on an MFA prompt or refused sign-in
AGENT_STOP_ON_AUTH_FAILURE=true
# Allow clicks on delete/remove/purge/void controls
AGENT_ALLOW_DESTRUCTIVE=false
