# CLI fallback configuration. Desktop users configure the same connection in Settings.
# A saved shared ai.env overrides legacy per-profile model settings; real process variables win.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-5-20251101
# Company gateway, when needed (see docs/providers.md):
# ANTHROPIC_BASE_URL=https://gateway.example.com/anthropic
# ANTHROPIC_AUTH_TOKEN=
# Gateways that only serve OpenAI-style /v1/chat/completions (LiteLLM, most corporate GenAI services):
# LLM_API_FORMAT=openai
# LLM_MODEL=<model name the gateway lists>
# Corporate network: the OS certificate store is trusted automatically; otherwise
# HTTPS_PROXY=http://proxy.example.com:8080
# NODE_EXTRA_CA_CERTS=/path/to/company-root.pem

D365_BASE_URL=
D365_USERNAME=
D365_PASSWORD=
D365_COMPANY=USMF
# Declare sandbox only for a verified sandbox; unknown/production environments are refused.
D365_ENVIRONMENT_TYPE=
# Saved user session for MFA; produced by session-login:
D365_STORAGE_STATE=

# Optional Azure DevOps. No PAT means the Azure CLI's Microsoft-account sign-in.
AZDO_ORG_URL=
AZDO_PROJECT=
AZDO_PAT=
# AZDO_AUTH=azure-cli
# AZDO_TENANT_ID=
# CLI defaults; in the desktop choose a plan/suite in Tests:
AZDO_TEST_PLAN_ID=
AZDO_TEST_SUITE_ID=

# Optional diagnostics. Defaults are suitable for ordinary runs.
PW_HEADLESS=true
PW_TRACE=on-failure
AGENT_DRY_RUN=false
# Dry runs skip clicks/typing and do not validate a business workflow.
# Record successful allowlisted Playwright MCP calls as standalone tests. Replay uses no model or MCP.
AGENT_RECORD_TESTS=true
# Optional: generated project location. Defaults to <REPORT_DIR>/replay for the active profile.
# AGENT_REPLAY_DIR=./reports/replay
AGENT_ALLOW_PRODUCTION=false
AGENT_ALLOW_DESTRUCTIVE=false
AGENT_ALLOWED_HOSTS=
AGENT_TEST_TIMEOUT_MS=900000
AGENT_MAX_TOKENS_PER_TEST=1000000
AGENT_NAV_TIMEOUT_MS=90000
# Cases whose TBC placeholders stand for existing data: block (end blocked before running), partial (run the rest), off.
AGENT_PREFLIGHT=block
# Read-only F&O data access (OData) for checking prerequisites. Sign-in: browser (run d365-data-login once), password, azure-cli.
# Empty follows how the tests sign in.
AGENT_ODATA=true
D365_ODATA_AUTH=
# Existing data a case leaves unset (an active vendor, an item, a warehouse): let the agent find one in F&O (needs AGENT_ODATA).
# After a passing run, `save-parameters` lets you explicitly save the chosen values to empty test case parameters.
AGENT_FILL_FROM_ERP=true
# Dynamics 365 ERP MCP server (<F&O address>/mcp, read only data tools). Uses the data-access sign-in; its client id
# 04b07795-8ddb-461a-bbee-02f9e1bf7b46 must be added and allowed in F&O > Allowed MCP clients. D365_MCP_URL only if it lives elsewhere.
AGENT_D365_MCP=true
D365_MCP_URL=
# Your own Entra app (client id) for the data-access sign-in instead of the Azure CLI client. Public client, redirect http://localhost.
D365_MCP_CLIENT_ID=
# Test environment: the agent decides values a case leaves unset (finds or makes one up, judges unset expected results) instead of blocking.
AGENT_JUDGE_UNSET=true
# A case that needs a specific user role: run it as the signed-in user instead of blocking it.
AGENT_IGNORE_USER_ROLE=true
# Discard the open form's unsaved changes when a case that changed data does not pass.
AGENT_DISCARD_UNSAVED=true
# Small learned form/control map, not a general knowledge base:
KB_DIR=./knowledge
# With an environment profile, reports default to reports/<permanent-profile-id>.
# REPORT_DIR=./reports
