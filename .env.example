# ─────────────────────────────────────────────────────────────
# d365FO-Agentic — example environment configuration
# Copy to `.env` and fill in the values you need. The agent
# auto-detects providers from what is present.
# ─────────────────────────────────────────────────────────────

# ── LLM provider ────────────────────────────────────────────
# One of: anthropic | openai | azure-openai | github-models | github-copilot
LLM_PROVIDER=anthropic
# Model for the anthropic provider (other providers use their own *_MODEL below)
LLM_MODEL=claude-opus-4-5-20251101
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Anthropic (Claude) — default
ANTHROPIC_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# GitHub Copilot (optional) — uses your Copilot subscription.
# Sign in once with `node dist/cli/index.js copilot-login`, or set a token here (e.g. CI).
GITHUB_COPILOT_TOKEN=
GITHUB_COPILOT_MODEL=gpt-4.1

# GitHub Models (optional) — separate prototyping API, not billed via Copilot
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=gpt-4o

# ── Azure DevOps ────────────────────────────────────────────
# PAT scopes required: Work Items (Read), Test Management (Read & Write)
AZDO_ORG_URL=https://dev.azure.com/your-org
AZDO_PROJECT=YourProject
AZDO_PAT=
AZDO_TEST_PLAN_ID=
AZDO_TEST_SUITE_ID=
# Set true to prefer the Azure DevOps MCP server when available; falls back to REST.
AZDO_USE_MCP=false

# ── D365 Finance & Operations ───────────────────────────────
D365_BASE_URL=https://your-sandbox.sandbox.operations.dynamics.com
D365_TENANT_ID=
D365_USERNAME=
D365_PASSWORD=
# Legal entity / company code used for test runs
D365_COMPANY=USMF

# ── Playwright MCP ──────────────────────────────────────────
PW_HEADLESS=true
PW_TRACE=on-failure
PW_VIDEO=off
PW_BROWSER=chromium
# Download the Playwright browser (~300 MB, once) automatically before a run when it is missing.
# Set false in offline/locked-down environments and install it yourself:
#   npx @playwright/mcp install-browser chrome-for-testing   (firefox / webkit for those PW_BROWSER values)
PW_AUTO_INSTALL=true

# ── Microsoft Learn MCP ─────────────────────────────────────
LEARN_MCP_URL=https://learn.microsoft.com/api/mcp

# ── Agent behavior ──────────────────────────────────────────
# dry-run planning only (no browser writes)
AGENT_DRY_RUN=false
# Print every model turn and tool call (Playwright actions included) with a truncated result
AGENT_VERBOSE=true
# Max iterations of the plan→act loop per test case
AGENT_MAX_STEPS=40
# Reloop controls (retries apply to failed/blocked outcomes by default)
AGENT_RELOOP_MAX_RETRIES=1
AGENT_RELOOP_RETRY_ON=failed,blocked
AGENT_RELOOP_COOLDOWN_MS=1000
# LLM network resilience
LLM_HTTP_TIMEOUT_MS=60000
LLM_HTTP_MAX_RETRIES=2
LLM_HTTP_RETRY_BASE_MS=500
# Azure DevOps network resilience
AZDO_HTTP_TIMEOUT_MS=60000
AZDO_HTTP_MAX_RETRIES=3
AZDO_HTTP_RETRY_BASE_MS=800
# Directory for local knowledge base
KB_DIR=./knowledge
# Directory for reports and artifacts
REPORT_DIR=./reports
